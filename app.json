{
  "expo": {
    "name": "SOFF",
    "slug": "SOFF",
    "scheme": "appSoff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#242424"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#242424",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.anonymous.SOFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#242424"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ]
  }
}